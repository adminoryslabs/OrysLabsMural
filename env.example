# ---------------------------------------------------------------------------
# Copy to .env for local development:  cp env.example .env
# NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Postgres (consumed by docker-compose.yml and by the app) --------------
POSTGRES_USER=mural
POSTGRES_PASSWORD=mural_dev_password
POSTGRES_DB=mural
POSTGRES_PORT=5433

# Application connection string.
# Local dev (app on host, Postgres in Docker):
DATABASE_URL=postgres://mural:mural_dev_password@localhost:5433/mural
# Inside docker compose the host is the service name instead:
# DATABASE_URL=postgres://mural:mural_dev_password@postgres:5432/mural

# Separate database used by the test suite. It is created and reset by the tests.
TEST_DATABASE_URL=postgres://mural:mural_dev_password@localhost:5433/mural_test

# --- App -------------------------------------------------------------------
NODE_ENV=development
# Force the Secure flag on session cookies. Must be true in production.
COOKIE_SECURE=false
# Session lifetime in days.
SESSION_TTL_DAYS=30

# --- Seed ------------------------------------------------------------------
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_NAME=Course Instructor
# Optional fixed teacher password. If omitted, one is generated and printed.
# SEED_TEACHER_PASSWORD=
# CSV roster: display_name,email (header optional). Defaults to scripts/roster.csv
SEED_ROSTER_FILE=scripts/roster.csv
# Fallback when no roster file exists: generate N students student01..studentNN
SEED_STUDENT_COUNT=25
SEED_STUDENT_EMAIL_DOMAIN=example.com

# --- Production only (docker-compose.prod.yml + Caddyfile) -----------------
# Domain Caddy will request a TLS certificate for.
APP_DOMAIN=mural.example.com
# Email used by Let's Encrypt for expiry notices.
ACME_EMAIL=admin@example.com
# Public websocket URL the browser will use (Phase B).
NEXT_PUBLIC_YJS_URL=wss://mural.example.com/yjs
