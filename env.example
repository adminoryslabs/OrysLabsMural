# ---------------------------------------------------------------------------
# Copy to .env for local development:  cp env.example .env
# NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Postgres (consumed by docker-compose.yml and by the app) --------------
POSTGRES_USER=mural
POSTGRES_PASSWORD=mural_dev_password
POSTGRES_DB=mural
POSTGRES_PORT=5433

# Application connection string.
# Local dev (app on host, Postgres in Docker):
DATABASE_URL=postgres://mural:mural_dev_password@localhost:5433/mural
# Inside docker compose the host is the service name instead:
# DATABASE_URL=postgres://mural:mural_dev_password@postgres:5432/mural

# Separate database used by the test suite. It is created and reset by the tests.
TEST_DATABASE_URL=postgres://mural:mural_dev_password@localhost:5433/mural_test

# --- App -------------------------------------------------------------------
NODE_ENV=development
# Force the Secure flag on session cookies. Must be true in production.
COOKIE_SECURE=false
# Session lifetime in days.
SESSION_TTL_DAYS=30

# --- Board images ----------------------------------------------------------
# Largest single image a user may upload to a board, in bytes (default 5 MiB).
# The bytes are stored in Postgres and served back over HTTP; they never enter
# the Yjs document. Only png, jpeg, webp and gif are accepted - SVG is refused
# on purpose, because an SVG served inline from this origin can run scripts.
BOARD_FILE_MAX_BYTES=5242880

# --- Seed ------------------------------------------------------------------
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_NAME=Course Instructor
# Optional fixed teacher password. If omitted, one is generated and printed.
# SEED_TEACHER_PASSWORD=
# CSV roster: display_name,email (header optional). Defaults to scripts/roster.csv
SEED_ROSTER_FILE=scripts/roster.csv
# Fallback when no roster file exists: generate N students student01..studentNN
SEED_STUDENT_COUNT=25
SEED_STUDENT_EMAIL_DOMAIN=example.com

# --- Collaboration server (yjs-server) -------------------------------------
# Websocket URL the browser opens. Local development talks to the Yjs process
# directly; in production Caddy proxies /yjs on the app's own domain, which is
# what makes the browser send the session cookie on the upgrade request.
NEXT_PUBLIC_YJS_URL=ws://localhost:1234

# Where the Yjs server listens.
YJS_PORT=1234
YJS_HOST=0.0.0.0
# How long after the last change the document is written to board_snapshots.
YJS_SNAPSHOT_DEBOUNCE_MS=2000
# How many snapshots per board are kept (append-only history for rollback).
YJS_SNAPSHOT_HISTORY=20
# Participation heartbeat. This is what bounds a tab that dies without closing.
YJS_HEARTBEAT_MS=20000
# How often the open boards are re-read so a status change (freeze, unfreeze,
# read only) is pushed to everyone already connected. One query per interval
# for the whole process, whatever the number of students.
YJS_STATUS_POLL_MS=3000
# How often open sessions are swept, and how silent one must be to be closed.
YJS_REAPER_MS=60000
YJS_STALE_AFTER_SECONDS=120

# --- Production only (docker-compose.prod.yml + Caddyfile) -----------------
# Domain Caddy will request a TLS certificate for.
APP_DOMAIN=mural.example.com
# Email used by Let's Encrypt for expiry notices.
ACME_EMAIL=admin@example.com
# In production override the websocket URL with the public one:
# NEXT_PUBLIC_YJS_URL=wss://mural.example.com/yjs
