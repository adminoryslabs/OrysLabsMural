# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# testing
/coverage

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets)
.env
.env.local
.env.*.local
.env.production

# seed output (contains generated plaintext credentials)
/seed-credentials.csv
/scripts/roster.csv

# editors
.idea/
.vscode/

# Local tooling caches
.atl/

# Excalidraw fonts, copied from node_modules by `npm run assets`
/public/excalidraw/

# The icon catalog lives in the `icon_catalog` DB table now, not on disk.
# Nothing writes here anymore, but this stays ignored in case a local script
# ever dumps icon bytes here for a one-off need.
/public/icons/
